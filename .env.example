# Modelo de variáveis de ambiente do Portal Perfin.
# Copie para .env (nunca versionado) e preencha. Aqui só há nomes e placeholders.
# Guia completo: Documentacao/configuracao.md

# --- Pública (a ÚNICA que vai ao navegador; embutida no build) ---
# URL oficial do portal na Vercel (ou domínio próprio), sem barra final.
NEXT_PUBLIC_SITE_URL=https://<seu-projeto>.vercel.app

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<...>
# Chave secreta: só no servidor (Vercel) e no coletor (GitHub Actions). Ignora a RLS.
SUPABASE_SECRET_KEY=sb_secret_<...>
# Só para aplicar migrations a partir da sua máquina. NÃO vai para a Vercel.
SUPABASE_DB_URL=postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres

# --- Google OAuth (provedor de login no Supabase e renovação dos tokens no servidor) ---
GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<client-secret>

# --- Acesso ---
# E-mails com acesso ao portal, separados por vírgula (os mesmos usuários de teste do Google).
ADMIN_EMAILS=<email1>,<email2>

# --- Cifra dos refresh tokens do Google (AES-256-GCM) ---
# 32 bytes em base64. Gere com o Node portátil (Bash):
#   export PATH="$(cygpath "$LOCALAPPDATA")/nodejs/node-v24.19.0-win-x64:$PATH"
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Trocar a chave invalida os tokens já gravados (os usuários refazem o login).
TOKEN_ENCRYPTION_KEY=<32-bytes-em-base64>

# --- Gemini (assistente; chamado só pelo servidor) ---
GEMINI_API_KEY=<chave-gemini>
# Modelos separados por vírgula, na ordem de tentativa (fallback).
GEMINI_MODELOS=<modelo-principal>,<modelo-reserva>

# --- Repositório (referência; não vai para a Vercel) ---
GITHUB_REPO=https://github.com/<usuario>/<repo>
